# Server Configuration
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# MongoDB Atlas Connection URI
# In development, an automatic embedded MongoDB engine starts if MONGODB_URI is empty.
# In production, provide your MongoDB Atlas cluster connection URI:
MONGODB_URI=""

# Administrator Configuration
# Configure your initial / primary administrator credentials through environment variables.
# Real credentials must NEVER be checked into source control; specify them in your private .env file.
ADMIN_EMAIL=siam@gmail.com
ADMIN_PASSWORD=siam12345!

# JWT Authentication Secret (Use a strong random 256-bit string in production)
JWT_SECRET=""

# Cloudinary (Mandatory for persistent product, banner, and brand image uploads)
CLOUDINARY_CLOUD_NAME="novara-cloud"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Resend Transactional Email API
RESEND_API_KEY="re_123456789_placeholder"
EMAIL_FROM="orders@novaracommerce.com"

# Gemini API Key (Server-side AI features if needed)
GEMINI_API_KEY=""
